<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ===========================================================================
    PROJECT CONFIGURATION NOTES (read before changing this file)
    ===========================================================================
    * TargetFramework is pinned to net8.0-windows because we use WinForms and
      Win32 interop (SystemParametersInfo, the registry, Task Scheduler). This
      app will never run cross-platform, so there is no value in multi-targeting.
    * InvariantGlobalization is ON. We never format dates with a user's
      regional calendar (we always emit dd-MM-yyyy ourselves), so we don't
      need the ICU globalization data. This alone shaves several MB and a
      measurable slice of cold-start time off the published binary.
    * PublishTrimmed is deliberately OFF. WinForms relies on reflection-based
      designer/serialization plumbing that does not trim safely today - a
      trimmed WinForms app is a runtime crash waiting to happen. Chasing a
      smaller binary at the cost of reliability is the wrong trade for a
      background utility. See README.md "Why not trimmed?" for the full note.
    * ServerGarbageCollector is OFF (we want Workstation GC / Concurrent GC).
      This app is a UI app that is idle 99.99% of the time; workstation GC has
      a far smaller memory footprint and is the correct default for this
      workload profile.
    ===========================================================================
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DoomsdayClock</RootNamespace>
    <AssemblyName>DoomsdayClock</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Required by the source-generated LibraryImport P/Invoke marshalling
         stubs in Native/NativeMethods.cs (string marshalling in particular
         emits pointer/fixed-statement code). This is the modern,
         AOT/trim-friendly replacement for DllImport, and this flag is the
         one trade-off it asks for in return. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- High-DPI: render crisp on modern scaled displays instead of being
         bitmap-stretched by the OS. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Startup/runtime footprint tuning -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- Single-file portable publish (see README "Building" section) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>Doomsday Clock Contributors</Authors>
    <Product>Doomsday Clock</Product>
    <Description>A lightweight countdown-to-a-date wallpaper generator for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency in this project, and it's a first-party
         Microsoft package with zero transitive dependencies of its own:
         Microsoft.Win32.Registry is not bundled with every target
         framework, so we reference it explicitly rather than gamble on it
         being present via the Windows Desktop shared framework. Everything
         else the app needs (JSON, GDI+, Win32 interop) ships in the base
         class library already. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
